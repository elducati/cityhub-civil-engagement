# Database
DATABASE_URL=postgresql://postgres:***@localhost:5432/cityhub
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:***@localhost:5672

# Auth (generate a 32+ char secret: openssl rand -base64 32)
AUTH_JWT_SECRET=change-me-to-a-random-32-char-secret
AUTH_JWT_EXPIRY=7d # Note: Specified as 1 hour in ARCHITECTURE.md; 7d used for development convenience.

# Application
NODE_ENV=development
PORT=3000
SOCKET_PORT=3001
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info