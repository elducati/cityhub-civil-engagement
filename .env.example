# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cityhub
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Auth (generate a 32+ char secret: openssl rand -base64 32)
AUTH_JWT_SECRET=change-me-to-a-random-32-char-secret
AUTH_JWT_EXPIRY=7d

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info