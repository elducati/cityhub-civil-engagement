# Frontend Environment Variables
# Copy this to .env.local and fill in the values

# API Base URL (backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Application Name
NEXT_PUBLIC_APP_NAME="Civic Engagement Platform"

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:5173
NEXTAUTH_SECRET=                                        # Required: min 32-char secret

# Keycloak OIDC Configuration (for enterprise auth)
KEYCLOAK_CLIENT_ID=                                    # OIDC client ID from Keycloak
KEYCLOAK_CLIENT_SECRET=                                # OIDC client secret
KEYCLOAK_ISSUER=                                       # e.g., http://localhost:8080/realms/civic

# Optional: Analytics
NEXT_PUBLIC_GA_ID=                                     # Google Analytics measurement ID