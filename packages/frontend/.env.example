# Frontend Environment Variables
# Copy this to .env.local and fill in the values

# API Base URL (used by browser client-side)
NEXT_PUBLIC_API_URL=http://localhost:3000

# API URL used during Server-Side Rendering (SSR)
# In Docker: http://api:3000
# Local dev: http://localhost:3000
API_URL_FOR_SERVER=http://localhost:3000

# Application Name
NEXT_PUBLIC_APP_NAME="Civic Engagement Platform"

# Optional: Analytics
NEXT_PUBLIC_GA_ID=                                     # Google Analytics measurement ID
